{
  "functions": {
    "source": "functions"
  },
  "extensions": {
    "bq-recebimento-recusas": "firebase/firestore-bigquery-export@0.3.3",
    "bq-recebimentos": "firebase/firestore-bigquery-export@0.3.3",
    "bq-recebimento-transbordo-cargas": "firebase/firestore-bigquery-export@0.3.3",
    "bq-recebimento-notas": "firebase/firestore-bigquery-export@0.3.3",
    "bq-recebimento-cargas": "firebase/firestore-bigquery-export@0.3.3",
    "bq-devolucoes-notas": "firebase/firestore-bigquery-export@0.3.3"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8089
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "site": "daterrinha-inventario",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "tests/**",
      "scripts/**",
      "sw.template.js"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
