# Firestore -> BigQuery (espelho pra Transbordo/relatórios) — coleção
# recebimentos (lojas/{lojaId}/recebimentos). Mesmo padrão de
# bq-recebimento-recusas.env — espelho só de leitura, Firestore continua a
# fonte de gravação normal (Coletor/93-recebimento-operacao.js).
DATASET_LOCATION=southamerica-east1
BIGQUERY_PROJECT_ID=daterrinha-inventario
DATABASE=(default)
DATABASE_REGION=southamerica-east1
COLLECTION_PATH=lojas/{lojaId}/recebimentos
WILDCARD_IDS=true
DATASET_ID=dt_relatorios
TABLE_ID=recebimentos
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info
MAX_ENQUEUE_ATTEMPTS=3
MAX_DISPATCHES_PER_SECOND=100
