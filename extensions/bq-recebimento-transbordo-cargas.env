# Firestore -> BigQuery (espelho pra Cargas/Montagem, tela 104) — coleção
# recebimento_transbordo_cargas (lojas/{lojaId}/recebimento_transbordo_cargas).
# Mesmo padrão de bq-recebimento-recusas.env.
DATASET_LOCATION=southamerica-east1
BIGQUERY_PROJECT_ID=daterrinha-inventario
DATABASE=(default)
DATABASE_REGION=southamerica-east1
COLLECTION_PATH=lojas/{lojaId}/recebimento_transbordo_cargas
WILDCARD_IDS=true
DATASET_ID=dt_relatorios
TABLE_ID=recebimento_transbordo_cargas
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info
MAX_ENQUEUE_ATTEMPTS=3
MAX_DISPATCHES_PER_SECOND=100
