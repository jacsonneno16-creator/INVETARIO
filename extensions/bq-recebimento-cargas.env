# Firestore -> BigQuery — espelho somente de leitura para cargas sincronizadas
# da Bluesoft. O Firestore continua sendo a fonte de gravação.
DATASET_LOCATION=southamerica-east1
BIGQUERY_PROJECT_ID=daterrinha-inventario
DATABASE=(default)
DATABASE_REGION=southamerica-east1
COLLECTION_PATH=recebimento_cargas
WILDCARD_IDS=false
DATASET_ID=dt_relatorios
TABLE_ID=recebimento_cargas
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info
MAX_ENQUEUE_ATTEMPTS=3
MAX_DISPATCHES_PER_SECOND=100
