# Firestore -> BigQuery (espelho pra consulta/indicadores) — coleção
# devolucoes_notas ({lojaId} vira coluna via WILDCARD_IDS, já que a coleção
# real fica em lojas/{lojaId}/devolucoes_notas). Diferente de
# bq-recebimento-recusas.env (só o que já foi confirmado): aqui entra TODO
# devolução importada do BI, pendente ou recebida — é o que torna o catálogo
# fiscal consultável por chave mesmo ANTES do retorno físico. Espelho só de
# leitura, o Firestore continua sendo a fonte de gravação normal.
DATASET_LOCATION=southamerica-east1
BIGQUERY_PROJECT_ID=daterrinha-inventario
DATABASE=(default)
DATABASE_REGION=southamerica-east1
COLLECTION_PATH=lojas/{lojaId}/devolucoes_notas
WILDCARD_IDS=true
DATASET_ID=dt_relatorios
TABLE_ID=devolucoes_notas
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info
MAX_ENQUEUE_ATTEMPTS=3
MAX_DISPATCHES_PER_SECOND=100
