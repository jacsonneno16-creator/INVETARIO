# Firestore -> BigQuery (espelho pra relatórios/indicadores) — piloto na
# coleção recebimento_recusas ({lojaId} vira coluna via WILDCARD_IDS, já que
# a coleção real fica em lojas/{lojaId}/recebimento_recusas). Não interfere
# em nada do que o app já faz — é um espelho só de leitura, o Firestore
# continua sendo a fonte de gravação normal.
DATASET_LOCATION=southamerica-east1
BIGQUERY_PROJECT_ID=daterrinha-inventario
DATABASE=(default)
DATABASE_REGION=southamerica-east1
COLLECTION_PATH=lojas/{lojaId}/recebimento_recusas
WILDCARD_IDS=true
DATASET_ID=dt_relatorios
TABLE_ID=recebimento_recusas
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info
MAX_ENQUEUE_ATTEMPTS=3
MAX_DISPATCHES_PER_SECOND=100
