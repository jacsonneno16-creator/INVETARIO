rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios_acessos/$(request.auth.uid));
    }

    function access() {
      return get(/databases/$(database)/documents/usuarios_acessos/$(request.auth.uid)).data;
    }

    function active() {
      return accessExists() &&
        (!access().keys().hasAny(['ativo']) || access().ativo != false);
    }

    function admin() {
      return active() && (
        (access().keys().hasAny(['perfil']) && access().perfil == 'administrador') ||
        (access().keys().hasAny(['admin_mestre']) && access().admin_mestre == true) ||
        (access().keys().hasAny(['administrador_mestre']) && access().administrador_mestre == true)
      );
    }

    function canUseAnalista() {
      return active() && (
        admin() ||
        (access().keys().hasAny(['perfil']) && access().perfil == 'analista') ||
        (
          access().keys().hasAny(['canais_acesso']) &&
          access().canais_acesso is map &&
          access().canais_acesso.analista == true
        )
      );
    }

    function canUseColetor() {
      return active() && (
        admin() ||
        (
          access().keys().hasAny(['canais_acesso']) &&
          access().canais_acesso is map &&
          access().canais_acesso.coletor == true
        ) ||
        (access().keys().hasAny(['perfil']) && access().perfil == 'operador')
      );
    }

    function hasPermission(area, operation) {
      return admin() || (
        canUseAnalista() &&
        access().keys().hasAny(['permissoes']) &&
        access().permissoes is map &&
        access().permissoes.keys().hasAny([area]) &&
        access().permissoes[area] is map &&
        access().permissoes[area].keys().hasAny([operation]) &&
        access().permissoes[area][operation] == true
      );
    }

    function canCreateAudit() {
      return hasPermission('auditoria', 'criar') ||
        hasPermission('auditoria', 'editar');
    }

    function canEditAudit() {
      return hasPermission('auditoria', 'editar');
    }

    function canImportAudit() {
      return hasPermission('auditoria', 'importar') ||
        hasPermission('auditoria', 'editar');
    }

    function canPublishAudit() {
      return hasPermission('auditoria', 'publicar') ||
        hasPermission('auditoria', 'editar');
    }

    function canFinishAudit() {
      return hasPermission('auditoria', 'finalizar') ||
        hasPermission('auditoria', 'editar');
    }

    function canDeleteAudit() {
      return hasPermission('auditoria', 'excluir');
    }

    function canAccessStore(lojaId) {
      return active() && (
        admin() ||
        (
          access().keys().hasAny(['acesso_todas_lojas']) &&
          access().acesso_todas_lojas == true
        ) ||
        (
          access().keys().hasAny(['lojas_permitidas']) &&
          access().lojas_permitidas is list &&
          lojaId in access().lojas_permitidas
        )
      );
    }

    function storeIdFromData(data) {
      return data.keys().hasAny(['lojaId']) ? data.lojaId :
        (
          data.keys().hasAny(['loja_id']) ? data.loja_id :
          (
            data.keys().hasAny(['loja']) ? data.loja : null
          )
        );
    }

    function canAccessDocumentStore(data) {
      return active() && (
        admin() ||
        (
          access().keys().hasAny(['acesso_todas_lojas']) &&
          access().acesso_todas_lojas == true
        ) ||
        (
          storeIdFromData(data) is string &&
          access().keys().hasAny(['lojas_permitidas']) &&
          access().lojas_permitidas is list &&
          storeIdFromData(data) in access().lojas_permitidas
        )
      );
    }

    function collectorCanReadOperationalDoc(data) {
      return canUseColetor() && canAccessDocumentStore(data);
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validOperationalWrite() {
      return request.resource.data.keys().hasAny(['inventario_id', 'inventarioId']) &&
        (
          !request.resource.data.keys().hasAny(['quantidade']) ||
          (
            request.resource.data.quantidade is number &&
            request.resource.data.quantidade >= 0 &&
            request.resource.data.quantidade <= 999999999
          )
        );
    }

    function inventoryId(data) {
      return data.inventario_id != null ? data.inventario_id : data.inventarioId;
    }

    function inventoryOpen(lojaId, data) {
      return inventoryId(data) is string &&
        exists(/databases/$(database)/documents/lojas/$(lojaId)/dt_inventarios/$(inventoryId(data))) &&
        get(/databases/$(database)/documents/lojas/$(lojaId)/dt_inventarios/$(inventoryId(data))).data.status
          in ['ATIVO', 'ABERTO', 'EM_ANDAMENTO'];
    }

    function sameOperator(data) {
      return
        (
          data.keys().hasAny(['operador_uid']) &&
          data.operador_uid == request.auth.uid
        ) ||
        (
          data.keys().hasAny(['coletor_uid']) &&
          data.coletor_uid == request.auth.uid
        ) ||
        (
          data.keys().hasAny(['uid']) &&
          data.uid == request.auth.uid
        ) ||
        (
          data.keys().hasAny(['operador_id']) &&
          access().keys().hasAny(['email']) &&
          data.operador_id == access().email
        ) ||
        (
          data.keys().hasAny(['operador_id']) &&
          request.auth.token.keys().hasAny(['email']) &&
          data.operador_id == request.auth.token.email
        );
    }

    function validAuditCollectorItem() {
      return request.resource.data.keys().hasOnly([
        'auditoriaId',
        'itemId',
        'endereco',
        'status',
        'disponivel_coletor',
        'loja',
        'ordem',
        'versaoBase',
        'atualizadoEm'
      ]) &&
      request.resource.data.auditoriaId is string &&
      request.resource.data.endereco is string &&
      request.resource.data.loja is string;
    }

    function assignedToCurrentUser(data) {
      return sameOperator(data) ||
        (
          data.keys().hasAny(['operador']) &&
          access().keys().hasAny(['nome']) &&
          data.operador == access().nome
        ) ||
        (
          data.keys().hasAny(['operador_responsavel']) &&
          access().keys().hasAny(['nome']) &&
          data.operador_responsavel == access().nome
        ) ||
        (
          data.keys().hasAny(['operador']) &&
          access().keys().hasAny(['email']) &&
          data.operador == access().email
        );
    }

    function safeUserScope() {
      return admin() || (
        (!request.resource.data.keys().hasAny(['perfil']) ||
          request.resource.data.perfil != 'administrador') &&
        (!request.resource.data.keys().hasAny(['admin_mestre']) ||
          request.resource.data.admin_mestre != true) &&
        (!request.resource.data.keys().hasAny(['administrador_mestre']) ||
          request.resource.data.administrador_mestre != true) &&
        (
          (
            access().keys().hasAny(['acesso_todas_lojas']) &&
            access().acesso_todas_lojas == true
          ) ||
          (
            (
              !request.resource.data.keys().hasAny(['acesso_todas_lojas']) ||
              request.resource.data.acesso_todas_lojas != true
            ) &&
            request.resource.data.lojas_permitidas is list &&
            request.resource.data.lojas_permitidas.hasOnly(access().lojas_permitidas)
          )
        )
      );
    }

    match /usuarios_acessos/{userId} {
      allow read: if active() && (
        request.auth.uid == userId ||
        admin() ||
        hasPermission('operadores', 'visualizar')
      );

      allow create: if request.auth.uid != userId &&
        hasPermission('operadores', 'criar') &&
        safeUserScope();

      allow update: if request.auth.uid != userId &&
        hasPermission('operadores', 'editar') &&
        safeUserScope();

      allow delete: if request.auth.uid != userId &&
        hasPermission('operadores', 'excluir') &&
        resource.data.admin_mestre != true &&
        resource.data.administrador_mestre != true;
    }

    match /lojas/{lojaId} {
      allow read: if canAccessStore(lojaId);
      allow create, update: if admin() && validText(request.resource.data.nome, 120);
      allow delete: if false;

      match /dt_contagens/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create: if canAccessStore(lojaId) &&
          canUseColetor() &&
          sameOperator(request.resource.data) &&
          validOperationalWrite() &&
          inventoryOpen(lojaId, request.resource.data);

        allow update, delete: if canAccessStore(lojaId) &&
          canUseAnalista();
      }

      match /dt_vazios/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create: if canAccessStore(lojaId) &&
          canUseColetor() &&
          sameOperator(request.resource.data) &&
          validOperationalWrite() &&
          inventoryOpen(lojaId, request.resource.data);

        allow update, delete: if canAccessStore(lojaId) &&
          canUseAnalista();
      }

      match /dt_recontagens/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create, delete: if canAccessStore(lojaId) &&
          hasPermission('recontagens', 'editar');

        allow update: if canAccessStore(lojaId) && (
          hasPermission('recontagens', 'editar') ||
          (
            canUseColetor() &&
            assignedToCurrentUser(resource.data) &&
            (
              !request.resource.data.keys().hasAny(['operador_uid']) ||
              request.resource.data.operador_uid == request.auth.uid
            ) &&
            inventoryOpen(lojaId, request.resource.data) &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'quantidade',
                'quantidade_contada',
                'itens',
                'concluida_em',
                'recontagem_concluida_em',
                'atualizado_em',
                'sincronizado_em',
                'status_recontagem',
                'iniciada_em',
                'recontagem_iniciada_em',
                'operador_recontagem',
                'operador_uid',
                'numero_recontagem',
                'contagem_uuid'
              ])
          )
        );
      }

      match /dt_divergencias/{docId} {
        allow read: if canAccessStore(lojaId);
        allow write: if canAccessStore(lojaId) &&
          hasPermission('recontagens', 'editar');
      }

      match /dt_inventarios/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create: if canAccessStore(lojaId) &&
          hasPermission('inventarios', 'criar');

        allow update: if canAccessStore(lojaId) &&
          hasPermission('inventarios', 'editar') &&
          (
            (
              !resource.data.keys().hasAny(['versao']) &&
              request.resource.data.versao == 1
            ) ||
            request.resource.data.versao == resource.data.versao + 1
          );

        allow delete: if false;

        match /base_chunks/{chunkId} {
          allow read: if canAccessStore(lojaId);

          allow write: if canAccessStore(lojaId) &&
            hasPermission('inventarios', 'editar');
        }
      }

      match /dt_locais/{docId} {
        allow read: if canAccessStore(lojaId);

        allow write: if canAccessStore(lojaId) &&
          hasPermission('enderecos', 'editar');
      }

      match /dt_locais_chunks/{docId} {
        allow read: if canAccessStore(lojaId);

        allow write: if canAccessStore(lojaId) &&
          hasPermission('enderecos', 'editar');
      }

      match /dt_locais_meta/{docId} {
        allow read: if canAccessStore(lojaId);

        allow write: if canAccessStore(lojaId) &&
          hasPermission('enderecos', 'editar');
      }

      match /dt_operadores/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create: if canAccessStore(lojaId) &&
          hasPermission('operadores', 'criar');

        allow update: if canAccessStore(lojaId) &&
          hasPermission('operadores', 'editar');

        allow delete: if canAccessStore(lojaId) &&
          hasPermission('operadores', 'excluir');
      }

      match /dt_atribuicoes_contagem/{docId} {
        allow read: if canAccessStore(lojaId);

        allow create, delete: if canAccessStore(lojaId) &&
          hasPermission('recontagens', 'editar');

        allow update: if canAccessStore(lojaId) && (
          hasPermission('recontagens', 'editar') ||
          (
            canUseColetor() &&
            assignedToCurrentUser(resource.data) &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'concluida_em',
                'atualizado_em',
                'sincronizado_em',
                'contagem_uuid',
                'quantidade_contada',
                'operador_uid'
              ])
          )
        );
      }

      match /dt_auditorias/{docId} {
        allow read: if canAccessStore(lojaId) &&
          canUseAnalista();

        allow create: if canAccessStore(lojaId) &&
          canCreateAudit();

        allow update: if canAccessStore(lojaId) && (
          canEditAudit() ||
          canPublishAudit() ||
          canFinishAudit()
        );

        allow delete: if canAccessStore(lojaId) &&
          canDeleteAudit();

        match /base_chunks/{chunkId} {
          allow read: if canAccessStore(lojaId) &&
            canUseAnalista();

          allow create, update: if canAccessStore(lojaId) && (
            canImportAudit() ||
            canEditAudit()
          );

          allow delete: if canAccessStore(lojaId) && (
            canEditAudit() ||
            canDeleteAudit()
          );
        }

        match /enderecos/{enderecoId} {
          allow read: if canAccessStore(lojaId) &&
            canUseAnalista();

          allow create, update: if canAccessStore(lojaId) && (
            canImportAudit() ||
            canEditAudit()
          );

          allow delete: if canAccessStore(lojaId) && (
            canEditAudit() ||
            canDeleteAudit()
          );
        }

        match /itens_coletor/{itemId} {
          allow read: if canAccessStore(lojaId) && (
            canUseAnalista() ||
            canUseColetor()
          );

          allow create, update: if canAccessStore(lojaId) && (
            canPublishAudit() ||
            canEditAudit()
          ) &&
          validAuditCollectorItem();

          allow delete: if canAccessStore(lojaId) && (
            canEditAudit() ||
            canDeleteAudit()
          );
        }

        match /resultados/{resultadoId} {
          allow read: if canAccessStore(lojaId) &&
            canUseAnalista();

          allow create, update: if canAccessStore(lojaId) &&
            canFinishAudit();

          allow delete: if canAccessStore(lojaId) &&
            canDeleteAudit();
        }

        match /ocorrencias/{ocorrenciaId} {
          allow read: if canAccessStore(lojaId) &&
            canUseAnalista();

          allow create, update: if canAccessStore(lojaId) && (
            canEditAudit() ||
            canFinishAudit()
          );

          allow delete: if canAccessStore(lojaId) && (
            canEditAudit() ||
            canDeleteAudit()
          );
        }
      }

      match /dt_auditorias_coletor/{docId} {
        allow read: if canAccessStore(lojaId) && (
          canUseAnalista() ||
          canUseColetor()
        );

        allow create, update: if canAccessStore(lojaId) && (
          canPublishAudit() ||
          canEditAudit()
        );

        allow delete: if canAccessStore(lojaId) && (
          canEditAudit() ||
          canDeleteAudit()
        );
      }

      match /dt_auditoria_imports/{docId} {
        allow read: if canAccessStore(lojaId) &&
          canUseAnalista();

        allow create, update: if canAccessStore(lojaId) && (
          canImportAudit() ||
          canEditAudit()
        );

        allow delete: if canAccessStore(lojaId) && (
          canEditAudit() ||
          canDeleteAudit()
        );
      }

      match /dt_bloqueios_recontagem/{docId} {
        allow read: if canAccessStore(lojaId);

        allow write: if canAccessStore(lojaId) && (
          hasPermission('recontagens', 'editar') ||
          (
            canUseColetor() &&
            request.resource.data.operador_uid == request.auth.uid &&
            inventoryOpen(lojaId, request.resource.data)
          )
        );
      }

      match /dt_logs_analista/{docId} {
        allow read: if canAccessStore(lojaId) &&
          canUseAnalista();

        allow create: if canAccessStore(lojaId) &&
          canUseAnalista() &&
          request.resource.data.usuario_uid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /dt_coletores/{deviceId} {
      allow get: if signedIn();

      allow list: if active() && (
        canUseAnalista() ||
        resource.data.uid == request.auth.uid ||
        resource.data.operador_uid == request.auth.uid
      );

      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.operador_uid == request.auth.uid &&
        request.resource.data.device_id == deviceId &&
        request.resource.data.aprovado == 'pendente' &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.excluido == false;

      allow update: if hasPermission('coletores', 'editar') || (
        signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.operador_uid == request.auth.uid &&
        request.resource.data.device_id == deviceId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'uid',
            'device_id',
            'nome_coletor',
            'numero',
            'operador_uid',
            'operador_atual',
            'operador_email',
            'ultimo_ping',
            'status',
            'aprovado',
            'data_registro',
            'sessao',
            'ip',
            'versao_app',
            'contagens_enviadas',
            'contagens_pendentes',
            'excluido',
            'revogado_em'
          ]) &&
        (
          (
            resource.data.keys().hasAny(['aprovado']) &&
            resource.data.aprovado == 'aprovado' &&
            request.resource.data.aprovado == 'aprovado' &&
            request.resource.data.excluido == false
          ) ||
          (
            resource.data.keys().hasAny(['aprovado']) &&
            resource.data.aprovado == 'bloqueado' &&
            request.resource.data.aprovado == 'bloqueado' &&
            request.resource.data.excluido == resource.data.excluido
          ) ||
          (
            resource.data.keys().hasAny(['aprovado']) &&
            resource.data.aprovado == 'pendente' &&
            request.resource.data.aprovado == 'pendente' &&
            request.resource.data.excluido == false
          ) ||
          (
            (
              !resource.data.keys().hasAny(['aprovado']) ||
              !resource.data.keys().hasAny(['excluido']) ||
              resource.data.aprovado == 'revogado' ||
              resource.data.excluido == true
            ) &&
            request.resource.data.aprovado == 'pendente' &&
            request.resource.data.status == 'pendente' &&
            request.resource.data.excluido == false
          )
        )
      );

      allow delete: if hasPermission('coletores', 'excluir');
    }

    match /dt_produtos/{docId} {
      allow read: if active();

      allow write: if hasPermission('produtos', 'editar') ||
        hasPermission('produtos', 'importar');
    }

    match /dt_produtos_chunks/{docId} {
      allow read: if active();

      allow write: if hasPermission('produtos', 'editar') ||
        hasPermission('produtos', 'importar');
    }

    match /dt_produtos_meta/{docId} {
      allow read: if active();

      allow write: if hasPermission('produtos', 'editar') ||
        hasPermission('produtos', 'importar');
    }

    match /dt_atribuicoes_contagem/{docId} {
      allow read: if active() && (
        canUseAnalista() ||
        resource.data.operador_uid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );

      allow create, update, delete: if hasPermission('recontagens', 'editar');
    }

    match /dt_auditorias/{docId} {
      allow read: if canUseAnalista() ||
        collectorCanReadOperationalDoc(resource.data);

      allow create: if canCreateAudit() &&
        canAccessDocumentStore(request.resource.data);

      allow update: if (
        canEditAudit() ||
        canPublishAudit() ||
        canFinishAudit()
      ) &&
      canAccessDocumentStore(request.resource.data);

      allow delete: if canDeleteAudit() &&
        canAccessDocumentStore(resource.data);

      match /{subcolecao}/{subId} {
        allow read: if canUseAnalista() &&
          subcolecao in [
            'base_chunks',
            'enderecos',
            'ocorrencias',
            'itens_coletor',
            'resultados'
          ];

        allow create, update: if (
          canImportAudit() ||
          canEditAudit() ||
          canPublishAudit() ||
          canFinishAudit()
        ) &&
        subcolecao in [
          'base_chunks',
          'enderecos',
          'ocorrencias',
          'itens_coletor',
          'resultados'
        ];

        allow delete: if (
          canEditAudit() ||
          canDeleteAudit()
        ) &&
        subcolecao in [
          'base_chunks',
          'enderecos',
          'ocorrencias',
          'itens_coletor',
          'resultados'
        ];
      }
    }

    match /dt_auditorias_coletor/{docId} {
      allow read: if collectorCanReadOperationalDoc(resource.data) ||
        canUseAnalista();

      allow create, update: if (
        canPublishAudit() ||
        canEditAudit()
      ) &&
      canAccessDocumentStore(request.resource.data);

      allow delete: if (
        canEditAudit() ||
        canDeleteAudit()
      ) &&
      canAccessDocumentStore(resource.data);
    }

    match /dt_inventarios/{docId} {
      allow read: if admin() ||
        collectorCanReadOperationalDoc(resource.data);

      allow create, update: if admin() &&
        hasPermission('inventarios', 'editar');

      allow delete: if false;

      match /{nested=**} {
        allow read: if admin() ||
          canUseColetor();

        allow write: if admin() &&
          hasPermission('inventarios', 'editar');
      }
    }

    match /{legacyCollection}/{docId} {
      allow read, write: if admin() &&
        legacyCollection in ['dt_locais', 'dt_operadores'];
    }

    match /{legacyCollection}/{document=**} {
      allow read, write: if false;
    }
  }
}
