rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    match /usuarios_acessos/{userId} { allow read, write: if signedIn(); }
    match /lojas/{lojaId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
      match /{document=**} { allow read, write: if signedIn(); }
    }
    // Base de produtos: catálogo global compartilhado entre todas as lojas
    // (fica fora de lojas/{lojaId} de propósito, para o coletor carregar uma
    // única base). Antes só tinha leitura liberada, o que bloqueava a
    // importação/edição/publicação da base com "Missing or insufficient permissions".
    match /dt_produtos/{document=**} { allow read, write: if signedIn(); }
    match /dt_produtos_chunks/{document=**} { allow read, write: if signedIn(); }
    match /dt_produtos_meta/{document=**} { allow read, write: if signedIn(); }
    // Coleções antigas: somente leitura para permitir migração para lojas/{lojaId}.
    match /{legacyCollection}/{document=**} {
      allow read: if signedIn() && legacyCollection != 'lojas';
      allow write: if false;
    }
  }
}
